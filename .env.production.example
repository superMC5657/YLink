# 生产环境变量模板(入库;复制为 .env.production 使用,cp .env.production.example .env.production)
# .env.production 本体被 .gitignore 忽略,本模板保证新克隆也能拿到全部配置说明。
VITE_APP_NAME=YLink
VITE_API_BASE_URL=http://localhost:8081/api/v1
VITE_USE_MOCK=false

# 前端站点域名(可选,推荐配置):注册邀请链接 / Tauri 打包版分享链接用。
# 未配置时 Web 版自动取当前页面 origin(本地 dev=5174、Caddy=80、生产 HTTPS=443);
# Tauri 打包版 WebView origin 不可分享(tauri:// 或 http(s)://tauri.localhost,见 src/stores/invite.ts),
# 必须在此显式指定,如 https://panel.example.com(前端为 hash 路由,链接形如 https://panel.example.com/#/register?code=)
# VITE_WEB_BASE_URL=https://panel.example.com

# Tauri 本地打包签名(可选;CI 发布改走 GitHub secrets,见 docs/frontend/desktop-tauri.md 签名密钥一节)
# TAURI_SIGNING_PRIVATE_KEY=<base64 私钥字符串>
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<私钥密码>
