{
  "name": "YLink",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "代理订阅售卖系统 · 用户端(响应式 Web + Tauri 2)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check-error-toast.mjs && node scripts/check-tokens-sync.mjs && node scripts/check-brand-hex.mjs && node scripts/check-admin-contract.mjs && eslint . --max-warnings 0 && stylelint \"src/styles/*.css\" \"src/**/*.vue\" && vue-tsc --noEmit && prettier --check . && vitest run",
    "fix": "eslint . --fix && stylelint --fix \"src/**/*.{css,vue}\" && prettier --write .",
    "e2e": "playwright test",
    "bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "contract:gen": "node scripts/gen-admin-contract.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html,webmanifest}": [
      "prettier --write"
    ],
    "*.{css,vue}": [
      "stylelint --fix"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all",
    "tabWidth": 2,
    "vueIndentScriptAndStyle": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "build",
          "ci",
          "chore",
          "revert"
        ]
      ]
    }
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "overrides": [
      {
        "files": [
          "**/*.vue"
        ],
        "customSyntax": "postcss-html"
      }
    ],
    "rules": {
      "comment-empty-line-before": null,
      "rule-empty-line-before": null,
      "declaration-empty-line-before": null,
      "no-empty-source": null,
      "custom-property-empty-line-before": null,
      "selector-class-pattern": null,
      "keyframes-name-pattern": null,
      "media-feature-range-notation": null,
      "import-notation": null,
      "length-zero-no-unit": null,
      "color-hex-length": null,
      "color-function-notation": null,
      "color-function-alias-notation": null,
      "alpha-value-notation": null,
      "hue-degree-notation": null,
      "font-family-name-quotes": null,
      "property-no-vendor-prefix": null,
      "selector-pseudo-class-no-unknown": [
        true,
        {
          "ignorePseudoClasses": [
            "deep",
            "global",
            "slotted"
          ]
        }
      ],
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "tailwind",
            "unocss",
            "apply",
            "screen"
          ]
        }
      ]
    },
    "ignoreFiles": [
      "dist/**",
      "node_modules/**",
      "coverage/**",
      "src-tauri/**",
      "server/**"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@vueuse/core": "^12.8.2",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.4",
    "echarts": "^5.6.0",
    "markdown-it": "^14.1.0",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.3.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@types/markdown-it": "^14.1.2",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "mockjs": "^1.1.0",
    "playwright": "^1.62.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.66.0",
    "unocss": "^0.65.4",
    "vite": "^6.2.0",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
