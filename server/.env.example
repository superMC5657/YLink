# YLink 环境变量模板（复制为 .env 并填写，勿提交真实密钥）
APP_ENV=development
APP_BASE_URL=http://localhost:8081
APP_DATABASE_DSN=host=postgres port=5433 user=ylink password=ylink_root dbname=ylink-backend sslmode=disable TimeZone=Asia/Shanghai
APP_REDIS_ADDR=redis:6379
APP_REDIS_PASSWORD=ylink_redis
APP_JWT_SECRET=please-change-me-32bytes-secret-key!!
APP_SMTP_HOST=smtp.qq.com
APP_SMTP_PORT=465
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_PAYMENT_EPAY_GATEWAY=https://pay.example.com
APP_PAYMENT_EPAY_PID=
APP_PAYMENT_EPAY_KEY=

POSTGRES_USER=ylink
POSTGRES_PASSWORD=ylink_root
POSTGRES_DB=ylink-backend
REDIS_PASSWORD=ylink_redis

# 首个管理员（服务启动时幂等创建）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
